    <!-- About -->
    <string name="about_title">बद्दल</string>
    <string name="about_version">आवृत्ती %1$s</string>
    <string name="about_footer">Made By Duggar PVT Ltd. All rights reserved.</string>
    <string name="about_description">AirWave हे जवळपासच्या डिव्हाइस-ते-डिव्हाइस संभाषणांसाठीचे ऑफलाइन ब्लूटूथ चॅट ॲप आहे. इंटरनेट नाही, सर्व्हर नाहीत, खाते नाही - ॲप उघडा, नाव टाका आणि आपल्या आसपासच्या AirWave वापरकर्त्यांशी चॅट करा. संभाषणे तात्पुरती असतात आणि जतन केली जात नाहीत.</string>

    <!-- Privacy (About) -->
    <string name="privacy_title">गोपनीयता</string>
    <string name="privacy_content">AirWave साठी खात्याची गरज नाही आणि ते ब्लूटूथद्वारे पूर्णपणे ऑफलाइन चालते. चॅट संदेश फक्त सक्रिय सत्रासाठी मेमरीमध्ये असतात आणि डिस्कनेक्ट केल्यावर पुसले जातात. आपले नाव फक्त सोयीसाठी स्थानिक पातळीवर लक्षात ठेवले जाते आणि कधीही बदलू किंवा पुसू शकता. AirWave आपला डेटा गोळा, साठवणूक किंवा पाठवत नाही.</string>

