    <!-- About -->
    <string name="about_title">সম্পর্কে</string>
    <string name="about_version">সংস্করণ %1$s</string>
    <string name="about_footer">Made By Duggar PVT Ltd. All rights reserved.</string>
    <string name="about_description">AirWave হলো কাছাকাছি ডিভাইস-থেকে-ডিভাইস কথোপকথনের জন্য একটি অফলাইন Bluetooth চ্যাট অ্যাপ। কোনো ইন্টারনেট নেই, সার্ভার নেই, অ্যাকাউন্ট নেই - শুধু অ্যাপ খুলুন, নাম লিখুন এবং আপনার চারপাশের AirWave ব্যবহারকারীদের সাথে চ্যাট করুন। কথোপকথনগুলি সাময়িক এবং সংরক্ষিত হয় না।</string>

    <!-- Privacy (About) -->
    <string name="privacy_title">গোপনীয়তা</string>
    <string name="privacy_content">AirWave-এর জন্য অ্যাকাউন্টের প্রয়োজন নেই এবং এটি Bluetooth-এর মাধ্যমে সম্পূর্ণ অফলাইনে কাজ করে। চ্যাট মেসেজগুলি শুধুমাত্র সক্রিয় সেশনের জন্য মেমরিতে থাকে এবং সংযোগ বিচ্ছিন্ন করলে মুছে যায়। আপনার নাম শুধুমাত্র সুবিধার জন্য স্থানীয়ভাবে মনে রাখা হয় এবং যেকোনো সময় পরিবর্তন বা মুছে ফেলা যায়। AirWave আপনার ডেটা সংগ্রহ, সংরক্ষণ বা প্রেরণ করে না।</string>

