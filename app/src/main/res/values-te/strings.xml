    <!-- About -->
    <string name="about_title">గురించి</string>
    <string name="about_version">వెర్షన్ %1$s</string>
    <string name="about_footer">Made By Duggar PVT Ltd. All rights reserved.</string>
    <string name="about_description">AirWave అనేది దగ్గరగా ఉన్న పరికరాల మధ్య సంభాషణల కోసం ఒక ఆఫ్‌లైన్ బ్లూటూత్ చాట్ యాప్. ఇంటర్నెట్ లేదు, సర్వర్లు లేవు, ఖాతా లేదు - యాప్ తెరిచి, పేరు నమోదు చేసి, మీ చుట్టూ ఉన్న AirWave వినియోగదారులతో చాట్ చేయండి. సంభాషణలు తాత్కాలికమైనవి, సేవ్ చేయబడవు.</string>

    <!-- Privacy (About) -->
    <string name="privacy_title">గోప్యత</string>
    <string name="privacy_content">AirWaveకి ఖాతా అవసరం లేదు మరియు బ్లూటూత్ ద్వారా పూర్తిగా ఆఫ్‌లైన్‌లో పనిచేస్తుంది. చాట్ సందేశాలు క్రియాశీల సెషన్ కోసం మాత్రమే మెమరీలో ఉంటాయి, మీరు డిస్‌కనెక్ట్ చేసినప్పుడు క్లియర్ చేయబడతాయి. మీ పేరు సౌలభ్యం కోసం మాత్రమే స్థానికంగా గుర్తుంచుకోబడుతుంది, దీన్ని ఎప్పుడైనా మార్చవచ్చు లేదా క్లియర్ చేయవచ్చు. AirWave మీ డేటాను సేకరించదు, నిల్వ చేయదు, ప్రసారం చేయదు.</string>

