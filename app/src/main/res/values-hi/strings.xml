    <!-- About -->
    <string name="about_title">के बारे में</string>
    <string name="about_version">संस्करण %1$s</string>
    <string name="about_footer">Made By Duggar PVT Ltd. All rights reserved.</string>
    <string name="about_description">AirWave एक ऑफ़लाइन ब्लूटूथ चैट ऐप है जो आस-पास के डिवाइस-से-डिवाइस संवाद के लिए है। कोई इंटरनेट नहीं, कोई सर्वर नहीं, कोई खाता नहीं - बस ऐप खोलें, नाम दर्ज करें और अपने आस-पास के AirWave उपयोगकर्ताओं से चैट करें। बातचीत अस्थायी होती हैं और सहेजी नहीं जातीं।</string>

    <!-- Privacy (About) -->
    <string name="privacy_title">गोपनीयता</string>
    <string name="privacy_content">AirWave के लिए खाते की आवश्यकता नहीं है और यह ब्लूटूथ के माध्यम से पूरी तरह से ऑफ़लाइन काम करता है। चैट संदेश केवल सक्रिय सत्र के लिए मेमोरी में रहते हैं और डिस्कनेक्ट होने पर साफ़ हो जाते हैं। आपका नाम केवल सुविधा के लिए स्थानीय रूप से याद रखा जाता है और इसे कभी भी बदला या साफ़ किया जा सकता है। AirWave आपका डेटा एकत्र, संग्रहीत या प्रसारित नहीं करता है।</string>

