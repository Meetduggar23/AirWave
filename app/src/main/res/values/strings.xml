    <!-- About -->
    <string name="about_title">About</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_footer">Made By Duggar PVT Ltd. All rights reserved.</string>
    <string name="about_description">AirWave is an offline Bluetooth chat app for nearby, device-to-device conversations. No internet, no servers, no account - just open the app, enter a name, and chat with AirWave users around you. Conversations are temporary and are not saved.</string>

    <!-- Privacy (About) -->
    <string name="privacy_title">Privacy</string>
    <string name="privacy_content">AirWave does not require an account and works fully offline over Bluetooth. Chat messages exist in memory only for the active session and are cleared when you disconnect. Your name is remembered locally as a convenience only and can be changed or cleared anytime. AirWave does not collect, store, or transmit your data.</string>

