<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvVerifyTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/verify_title"
                    android:textColor="@color/aw_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnVerifyClose"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/verify_close"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <!-- Tabs -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayoutVerify"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAllCaps="true"
                app:tabIndicatorColor="@color/airwave_accent"
                app:tabIndicatorFullWidth="false"
                app:tabIndicatorHeight="3dp"
                app:tabSelectedTextColor="@color/airwave_accent"
                app:tabTextColor="@color/aw_text_secondary">

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/verify_my_qr" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/verify_scan" />
            </com.google.android.material.tabs.TabLayout>

            <!-- Content -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- TAB 1: My QR -->
                <LinearLayout
                    android:id="@+id/layoutMyQr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="20dp">

                    <ImageView
                        android:id="@+id/ivQrCode"
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:background="@drawable/bg_qr_card"
                        android:contentDescription="@string/verify_qr_content_desc"
                        android:padding="12dp"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:id="@+id/tvQrIdentityLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/verify_identity_label"
                        android:textColor="@color/aw_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvQrName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/aw_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvQrCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="@string/verify_qr_caption"
                        android:textColor="@color/aw_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- TAB 2: Scan -->
                <LinearLayout
                    android:id="@+id/layoutScan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="20dp"
                    android:visibility="gone">

                    <!-- Camera preview -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardPreview"
                        android:layout_width="match_parent"
                        android:layout_height="240dp"
                        app:cardBackgroundColor="@color/aw_input_bg"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/aw_divider"
                        app:strokeWidth="1dp">

                        <androidx.camera.view.PreviewView
                            android:id="@+id/previewView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Scanning hint -->
                    <TextView
                        android:id="@+id/tvScanHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:text="@string/verify_scan_hint"
                        android:textColor="@color/aw_text_secondary"
                        android:textSize="13sp" />

                    <!-- Invalid QR message (kept visible while scanning continues) -->
                    <TextView
                        android:id="@+id/tvScanInvalid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/verify_qr_invalid"
                        android:textColor="@color/status_disconnected"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <!-- Verified result -->
                    <LinearLayout
                        android:id="@+id/layoutScanResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingTop="16dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:contentDescription="@string/verify_verified"
                            android:src="@drawable/ic_verified" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/verify_verified"
                            android:textColor="@color/aw_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvResultName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/airwave_accent"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:text="@string/verify_verified_msg"
                            android:textColor="@color/aw_text_secondary"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnScanAnother"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginTop="16dp"
                            android:text="@string/verify_scan_another"
                            android:textAllCaps="false"
                            app:backgroundTint="@color/airwave_accent"
                            app:cornerRadius="24dp"
                            app:icon="@drawable/ic_verify"
                            app:iconGravity="textStart"
                            app:iconTint="@color/white" />
                    </LinearLayout>

                    <!-- Permission state -->
                    <LinearLayout
                        android:id="@+id/layoutPermission"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingTop="24dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/verify_permission_required"
                            android:textColor="@color/aw_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPermissionMsg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:text="@string/verify_permission_denied_msg"
                            android:textColor="@color/aw_text_secondary"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPermissionAction"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginTop="16dp"
                            android:text="@string/verify_permission_grant"
                            android:textAllCaps="false"
                            app:backgroundTint="@color/airwave_accent"
                            app:cornerRadius="24dp" />
                    </LinearLayout>

                    <!-- Camera unavailable -->
                    <LinearLayout
                        android:id="@+id/layoutCameraUnavailable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingTop="24dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/verify_camera_unavailable"
                            android:textColor="@color/aw_text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>